# Copie para .env e preencha. O .env nao e versionado.

# Assina as sessoes do Django e os JWT emitidos em core/authentication.py.
# Gere uma chave propria por ambiente, nunca reaproveite entre ambientes:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# A aplicacao nao sobe sem esta variavel, de proposito.
SECRET_KEY=

# Postgres. Em deploy no Heroku o addon injeta DATABASE_URL automaticamente.
DATABASE_URL=
DB_DATABASE=
DB_HOST=
DB_PASSWORD=
DB_PORT=5432
DB_USERNAME=

# Microservico de usuarios.
USERS_MS=http://users-ms:8000
